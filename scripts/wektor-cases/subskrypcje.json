{
  "description": "Pytanie o jedną kategorię (inny temat niż przykłady w skillu Bank i niż porzadki-kategorie): Wektor ma policzyć z pełnej historii, pokazać kartą i powiedzieć, z jakiego okresu wnioskuje.",
  "turns": [
    {
      "say": "Ile wydaję na subskrypcje? Pokaż mi je",
      "expect": {
        "calls": [
          "panel_guide",
          "panel_bank",
          "panel_show"
        ],
        "notCalls": [
          "panel_todo_action",
          "panel_cezar_action",
          "panel_cezar_propose",
          "panel_recon_report"
        ],
        "maxTools": 8,
        "order": [
          [
            "panel_guide",
            "panel_bank"
          ]
        ]
      },
      "soft": [
        {
          "name": "podaje zakres dat lub okres",
          "text": "\\d{4}-\\d{2}-\\d{2}|\\d{1,2}\\.\\d{2}|od \\w+|miesi|rok"
        },
        {
          "name": "mówi o ograniczeniu danych (oznaczenia od niedawna)",
          "text": "oznacza|nieoznaczon|mało|krótk|od kiedy"
        },
        {
          "name": "nie wypisuje wierszy z karty ponownie",
          "text": "^(?![\\s\\S]*\\d{4}-\\d{2}-\\d{2}[\\s\\S]*\\d{4}-\\d{2}-\\d{2}[\\s\\S]*\\d{4}-\\d{2}-\\d{2})"
        }
      ]
    },
    {
      "say": "Tak",
      "expect": {
        "notCalls": [
          "panel_todo_action",
          "panel_cezar_action",
          "panel_cezar_propose",
          "panel_recon_report"
        ],
        "maxTools": 6,
        "textNot": [
          "nie da się"
        ]
      },
      "soft": [
        {
          "name": "nie wymienia operacji z karty (nie więcej niż 2 daty w tekście)",
          "text": "^(?![\\s\\S]*\\d{1,2}\\.\\d{2}[\\s\\S]*\\d{1,2}\\.\\d{2}[\\s\\S]*\\d{1,2}\\.\\d{2})"
        },
        {
          "name": "nie obiecuje zmian w koncie (dopisanie do kategorii)",
          "text": "^(?![\\s\\S]*(dopisać|dopiszę|przypisać|przypiszę)[\\s\\S]*kategori)"
        }
      ]
    }
  ]
}
