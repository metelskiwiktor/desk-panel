diff --git a/tests/warmupForce.test.ts b/tests/warmupForce.test.ts
new file mode 100644
index 0000000..0d1fb38
--- /dev/null
+++ b/tests/warmupForce.test.ts
@@ -0,0 +1,82 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp,rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { createQuotaWarmup,warmupSettings,WARMUP_PROVIDERS } from '../src/services/quotaWarmup.js';
+import { absent,type QuotaTelemetry,type QuotaObservation } from '../src/services/quotaTelemetry.js';
+
+for(const provider of WARMUP_PROVIDERS)test(`${provider}: explicit manual force bypasses opt-in, active window and durable cooldown, preserves locks and automatic rules`,async t=>{
+  const stateDir=await mkdtemp(path.join(tmpdir(),'warmup-force-'));
+  t.after(async()=>{assert.equal(path.dirname(stateDir),tmpdir());assert.ok(path.basename(stateDir).startsWith('warmup-force-'));await rm(stateDir,{recursive:true,force:true});});
+  const now=Date.now(),at=new Date(now).toISOString(),resetAt=new Date(now+3600000).toISOString();
+  const settings=warmupSettings({QUOTA_WARMUP_CODEX_MODEL:'synthetic-small'});
+  let calls=0,active:boolean|null=false,fail=false,unknown=false;
+  let entered=()=>{},release=()=>{};
+  let pause:Promise<void>|undefined;
+  const invoke=async()=>{calls++;entered();await pause;if(fail)throw new Error('cli_execution_failed');};
+  const deps={settings,stateDir,now:()=>now,active:async()=>active,claudePreflight:async()=>{},invoke,
+    invokeClaude:async(_trace:unknown,options:{allowActiveWindow:boolean})=>{
+      assert.equal(options.allowActiveWindow,true);await invoke();
+      return {sessionId:randomUUID(),model:'Haiku',responseVerified:true as const,historyVerified:true as const,
+        quotaBefore:{usedPercent:10,resetAt},quotaAfter:{usedPercent:11,resetAt},windowEffect:'already_active' as const};
+    },
+    read:async():Promise<QuotaTelemetry>=>{
+      const window:QuotaObservation={...absent(provider==='Gemini' ? 'gemini-5h' : '5h',now),
+        ...(provider==='Gemini' ? {model:'Gemini Models'} : {}),usedPercent:10,resetAt,observedAt:at,
+        state:unknown ? 'stale' : 'fresh',reason:unknown ? 'network_error' : null};
+      return {version:2,asOf:at,availability:'available',accounts:[{provider:provider==='Gemini' ? 'AGY' : provider,accountId:'synthetic',snapshots:[window],history:[]}]};
+    }};
+  const warmup=createQuotaWarmup(deps);
+  const force=()=>warmup.run(provider,false,false,false,{force:true});
+  assert.equal((await warmup.run(provider)).result,'disabled');
+  assert.equal((await warmup.run(provider,false,true,false,{force:true})).result,'disabled','scheduled cannot force');
+  assert.equal((await warmup.run(provider,true,false,false,{force:true})).result,'dry_run');
+  assert.equal(calls,0,'forced dry-run does not send a prompt or reserve cooldown');
+  assert.equal((await warmup.status()).last[provider],undefined);
+  const model=settings[provider].model;
+  settings[provider].model=provider==='Claude' ? 'opus' : provider==='Gemini' ? 'gemini-4-argon-low' : undefined;
+  assert.equal((await force()).result,provider==='Claude' ? 'claude_haiku_required' : provider==='Gemini' ? 'gemini_model_not_allowed' : 'model_required');
+  settings[provider].model=model;
+  assert.equal((await force()).result,provider==='Claude' ? 'completed_existing_window' : 'completed');
+  assert.equal(calls,1);assert.equal((await warmup.status()).settings[provider].enabled,false,'manual does not enable scheduler');
+  settings[provider].enabled=true;
+  assert.equal((await warmup.run(provider,false,true)).result,'duplicate_or_cooldown');
+  assert.equal((await createQuotaWarmup(deps).run(provider,false,false,false,{force:true})).result,provider==='Claude' ? 'completed_existing_window' : 'completed');
+  assert.equal(calls,2,'force survives persisted cooldown and already-started window');
+  // A failure still reserves the automatic cooldown, but cannot prevent the next manual retry.
+  fail=true;assert.equal((await force()).result,'failed_no_retry');
+  assert.equal((await warmup.run(provider,false,true)).result,'duplicate_or_cooldown');
+  fail=false;assert.match((await force()).result,/^completed/);assert.equal(calls,4);
+  active=true;assert.equal((await force()).result,'active_session');
+  active=null;assert.equal((await force()).result,'session_state_unknown');
+  active=false;unknown=true;assert.equal((await force()).result,'quota_unknown');unknown=false;
+  assert.equal(calls,4,'force keeps session and quota safety checks');
+  const started=new Promise<void>(resolve=>{entered=resolve;});
+  pause=new Promise<void>(resolve=>{release=resolve;});
+  const first=force();await started;
+  try{
+    assert.equal((await createQuotaWarmup(deps).run(provider,false,false,false,{force:true})).result,'locked');
+    assert.equal((await warmup.run(provider,false,true)).result,'locked');
+    assert.equal(calls,5,'one inference across instances and manual/automatic overlap');
+  }finally{release();await first;}
+  assert.match((await force()).result,/^completed/,'lock released after completion');
+  assert.equal(calls,6);
+  const history=(await warmup.status()).history;
+  assert.equal(history.length,6);assert.ok(history.every(entry=>entry.trigger==='manual'));
+});
+
+for(const provider of WARMUP_PROVIDERS)test(`${provider}: force flag is required and automatic active-window checks stay unchanged`,async t=>{
+  const stateDir=await mkdtemp(path.join(tmpdir(),'warmup-force-auto-'));
+  t.after(async()=>{assert.equal(path.dirname(stateDir),tmpdir());assert.ok(path.basename(stateDir).startsWith('warmup-force-auto-'));await rm(stateDir,{recursive:true,force:true});});
+  const now=Date.now();
+  const settings=warmupSettings({QUOTA_WARMUP_CODEX_MODEL:'synthetic-small'});settings[provider].enabled=true;
+  const warmup=createQuotaWarmup({settings,stateDir,active:async()=>false,
+    read:async()=>({version:2,asOf:new Date(now).toISOString(),availability:'available',accounts:[{
+      provider:provider==='Gemini' ? 'AGY' : provider,accountId:'synthetic',history:[],snapshots:[{
+        ...absent(provider==='Gemini' ? 'gemini-5h' : '5h',now),...(provider==='Gemini' ? {model:'Gemini Models'} : {}),
+        usedPercent:10,state:'fresh',reason:null,resetAt:new Date(now+3600000).toISOString(),observedAt:new Date(now).toISOString()}]}]})});
+  assert.equal((await warmup.run(provider)).result,'window_active');
+  assert.equal((await warmup.run(provider,false,true,false,{force:true})).result,'window_active');
+});
