{
  "projectRoot": "..",
  "pathPrefix": ["${UserProfile}\\.local\\bin"],
  "services": [
    {
      "id": "hermes",
      "name": "Desk-Panel-Hermes",
      "script": "servy/hermes.ps1",
      "workingDirectory": "${UserProfile}\\.desk-panel\\agent",
      "executable": "${UserProfile}\\.local\\bin\\hermes.exe",
      "arguments": ["gateway"],
      "envFile": "${UserProfile}\\.desk-panel\\hermes.env",
      "environment": {
        "API_SERVER_ENABLED": "true",
        "API_SERVER_HOST": "127.0.0.1",
        "API_SERVER_PORT": "8642",
        "TERMINAL_CWD": "${UserProfile}\\.desk-panel\\agent"
      }
    }
  ]
}
